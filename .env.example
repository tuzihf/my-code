# 环境变量示例
# 复制为 .env 并按需填写,或直接设置系统环境变量

# ---- 模型配置(必须) ----
# 方式一:DeepSeek API
DEEPSEEK_API_KEY=
# DeepSeek 模型名(可选,默认 deepseek-chat)
# DEEPSEEK_MODEL=deepseek-chat

# 方式二:OpenAI 兼容(OpenAI / Ollama 本地 / LM Studio 等)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# 本地 Ollama 示例:
# OPENAI_BASE_URL=http://localhost:11434/v1

# ---- 运行模式(可选) ----
# 设为 1 则用 Mock 模型(不联网,用于测试)
# MY_AGENT_MOCK=

# ---- 网页端 ----
# 服务器端口(默认 8000)
# PORT=8000
